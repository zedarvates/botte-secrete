{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "botte.rsi-graph/v1",
  "title": "Botte RSI Graph Observation v1",
  "type": "object",
  "required": [
    "schema",
    "mode",
    "read_only",
    "event_count",
    "nodes",
    "edges",
    "metrics",
    "limitations"
  ],
  "properties": {
    "schema": {
      "const": "botte.rsi-graph/v1"
    },
    "mode": {
      "const": "observe"
    },
    "read_only": {
      "const": true
    },
    "event_count": {
      "type": "integer",
      "minimum": 0
    },
    "nodes": {
      "type": "array"
    },
    "edges": {
      "type": "array"
    },
    "metrics": {
      "type": "object",
      "properties": {
        "cost": {
          "type": [
            "number",
            "null"
          ]
        },
        "tokens": {
          "type": [
            "integer",
            "null"
          ]
        },
        "compute": {
          "type": [
            "number",
            "null"
          ]
        },
        "energy": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
