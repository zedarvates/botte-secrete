{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zedarvates/botte-secrete/blob/main/docs/schemas/skill-run.schema.json",
  "title": "Observed skill execution report v1",
  "$comment": "Verified means the declared local predicates passed with process exit zero. This is not an independent task-quality verdict or permission to replay operations.",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "run_id", "plan_sha256", "context_sha256", "goal", "context", "started_at", "updated_at", "results", "mode", "summary", "complete", "coverage", "child_cost"],
  "properties": {
    "schema": {"const": "botte.skill-run/v1"},
    "run_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "plan_sha256": {"$ref": "#/$defs/hash"},
    "context_sha256": {"$ref": "#/$defs/hash"},
    "goal": {"type": "string"}, "context": {"type": "string"},
    "started_at": {"type": "number"}, "updated_at": {"type": "number"},
    "mode": {"enum": ["dry_run", "execution"]},
    "complete": {"type": "boolean"}, "coverage": {"type": "string"}, "child_cost": {"type": "null"},
    "summary": {"type": "object", "propertyNames": {"$ref": "#/$defs/state"}, "additionalProperties": {"type": "integer", "minimum": 0}},
    "results": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/result"}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "state": {"enum": ["pending", "running", "verified", "unverified", "failed", "blocked", "skipped", "uncertain", "stale"]},
    "observation": {
      "type": "object", "additionalProperties": false, "required": ["state"],
      "properties": {"state": {"enum": ["file", "absent", "unknown"]}, "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/hash"}, "reason": {"type": "string"}}
    },
    "observations": {"type": "object", "additionalProperties": {"$ref": "#/$defs/observation"}},
    "checks": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["kind", "path", "passed", "observed"],
      "properties": {"kind": {"enum": ["file_exists", "file_absent", "file_sha256", "text_contains", "json_equals"]},
        "path": {"type": "string"}, "passed": {"type": "boolean"}, "observed": {"$ref": "#/$defs/observation"}}
    }},
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "capability", "status", "started", "classification", "exit_code", "duration_s", "reused", "effects_before"],
      "properties": {
        "id": {"type": "string"}, "capability": {"type": "string"}, "status": {"$ref": "#/$defs/state"},
        "started": {"type": "boolean"}, "reused": {"type": "boolean"},
        "classification": {"enum": ["safe", "gated", "needs_args"]},
        "exit_code": {"type": ["integer", "null"]}, "duration_s": {"type": "number", "minimum": 0},
        "note": {"type": "string"}, "effects_before": {},
        "dependencies": {"type": "array", "items": {"type": "string"}},
        "before": {"$ref": "#/$defs/observations"}, "after": {"$ref": "#/$defs/observations"},
        "changed_paths": {"type": "array", "items": {"type": "string"}},
        "source_checks": {"$ref": "#/$defs/checks"}, "source_checks_after": {"$ref": "#/$defs/checks"},
        "precondition_checks": {"$ref": "#/$defs/checks"}, "postcondition_checks": {"$ref": "#/$defs/checks"},
        "resume_checks": {"$ref": "#/$defs/checks"}, "resume_sources": {"$ref": "#/$defs/checks"},
        "resume_precondition_checks": {"$ref": "#/$defs/checks"},
        "dependency_checks": {"type": "object", "additionalProperties": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "precondition_checks", "postcondition_checks", "source_checks"],
          "properties": {"status": {"$ref": "#/$defs/state"},
            "precondition_checks": {"$ref": "#/$defs/checks"},
            "postcondition_checks": {"$ref": "#/$defs/checks"},
            "source_checks": {"$ref": "#/$defs/checks"}}
        }},
        "source_coverage": {"enum": ["listed files only", "unbound"]},
        "output_sha256": {"$ref": "#/$defs/hash"}, "output_bytes": {"type": "integer", "minimum": 0}
      }
    }
  }
}
