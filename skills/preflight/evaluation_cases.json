      {
        "name": "compute_statistics",
        "description": "Compute deterministic descriptive statistics for supplied numeric values: mean median percentile variance sum."
      },
      {
        "name": "find_file_duplicates",
        "description": "Find exact file duplicates using SHA256 and byte comparisons; read only bounded local directory scan."
      },
      {
        "name": "check_local_links",
        "description": "Check local Markdown links from supplied documents and repository path inventory; report missing or unresolved targets."
      },
      {
        "name": "read_file",
        "description": "Read supplied document text for analysis."
      }
    ],
    "empty": [],
    "omitted": null,
    "unrelated": [
      {
        "name": "calendar_schedule",
        "description": "Appointments, events, dates."
      }
    ]
  },
