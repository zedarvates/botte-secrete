# Botte Secrète Configuration
# Copy to configs/botte-secrete.env and replace local hostnames as needed.

# Hailo-8 settings
HAILO_HOST=127.0.0.1
HAILO_PORT=8767

# ComfyUI settings
COMFYUI_HOST=127.0.0.1
COMFYUI_PORT=8188

# Bonsai Image settings
BONSAI_PORT=8788

# Qdrant settings (Second Brain)
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333

# RTK settings
RTK_MODE=rewrite
RTK_CACHE_SIZE=128

# Audit settings
AUDIT_TIMEOUT=60
AUDIT_OUTPUT_DIR=reports
