# Botte Secrète .gitignore

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/

# Rust build artifacts (machine-specific; the binary is rebuilt from src/)
target/
*.rlib
*.rmeta

# Node
node_modules/
*.min.js
*.min.css

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Hailo models (large binaries)
*.hef
*.hn

# ComfyUI models (large binaries)
*.safetensors
*.ckpt
*.bin

# Bonsai models
*.gguf
*.onnx

# Reports (generated)
reports/
/tmp/

# Secrets
*.env.local
*.secret

# Large data files
*.sqlite
*.db
.botte-cache/

# Machine-specific generated LLM registry (regenerate with: llm_backends scan)
configs/llm-endpoints.json

# Local MCP wiring (per-machine absolute paths)
.mcp.json

# Per-project deployer output (machine-specific paths + config)
.botte/
!.botte/policy.md

# Generated artifacts
fix-report.json
*.vtt
.venv312/
transcript.fr.srt
