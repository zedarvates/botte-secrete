{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zedarvates/botte-secrete/blob/main/docs/schemas/verified-mission.schema.json",
  "title": "Optional verified mission contract and detached trusted witnesses",
  "$ref": "#/$defs/contract",
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\x00-\\x1f]*\\S[^\\x00-\\x1f]*$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "verifier_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\x00-\\x1f]*\\S[^\\x00-\\x1f]*$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\x00-\\x1f]*\\S[^\\x00-\\x1f]*$"
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_sha256",
        "mission_id",
        "revision",
        "input_sha256",
        "verifier"
      ],
      "properties": {
        "contract_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "mission_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\x00-\\x1f]*\\S[^\\x00-\\x1f]*$"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\x00-\\x1f]*\\S[^\\x00-\\x1f]*$"
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "verifier": {
          "$ref": "#/$defs/verifier_identity"
        }
      }
    },
    "criterion_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_sha256",
        "mission_id",
        "revision",
        "input_sha256",
        "verifier",
        "criterion_id"
      ],
      "properties": {
        "contract_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "mission_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\x00-\\x1f]*\\S[^\\x00-\\x1f]*$"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\x00-\\x1f]*\\S[^\\x00-\\x1f]*$"
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "verifier": {
          "$ref": "#/$defs/verifier_identity"
        },
        "criterion_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\x00-\\x1f]*\\S[^\\x00-\\x1f]*$"
        }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "mission_id",
        "revision",
        "input",
        "verifier",
        "criteria",
        "review"
      ],
      "properties": {
        "schema": {
          "const": "botte.verified-mission/v1"
        },
        "mission_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\x00-\\x1f]*\\S[^\\x00-\\x1f]*$"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\x00-\\x1f]*\\S[^\\x00-\\x1f]*$"
        },
        "input": {
          "$ref": "#/$defs/file"
        },
        "verifier": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version",
            "path",
            "sha256"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\x00-\\x1f]*\\S[^\\x00-\\x1f]*$"
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\x00-\\x1f]*\\S[^\\x00-\\x1f]*$"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\x00-\\x1f]*\\S[^\\x00-\\x1f]*$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "description"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[^\\x00-\\x1f]*\\S[^\\x00-\\x1f]*$"
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[^\\x00-\\x1f]*\\S[^\\x00-\\x1f]*$"
              }
            }
          }
        },
        "review": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "required"
              ],
              "properties": {
                "required": {
                  "const": false
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "required",
                "implementer_id",
                "brief_sha256"
              ],
              "properties": {
                "required": {
                  "const": true
                },
                "implementer_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^[^\\x00-\\x1f]*\\S[^\\x00-\\x1f]*$"
                },
                "brief_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          ]
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "status",
        "mission_id",
        "contract_sha256",
        "criteria",
        "review_ref"
      ],
      "properties": {
        "schema": {
          "const": "botte.mission-completion/v1"
        },
        "status": {
          "type": "string"
        },
        "mission_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\x00-\\x1f]*\\S[^\\x00-\\x1f]*$"
        },
        "contract_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "criteria": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "witness_ref"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[^\\x00-\\x1f]*\\S[^\\x00-\\x1f]*$"
              },
              "witness_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[^\\x00-\\x1f]*\\S[^\\x00-\\x1f]*$"
              }
            }
          }
        },
        "review_ref": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\x00-\\x1f]*\\S[^\\x00-\\x1f]*$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "binding",
        "report_ref",
        "receipt_sha256"
      ],
      "properties": {
        "schema": {
          "const": "botte.mission-criterion/v1"
        },
        "binding": {
          "$ref": "#/$defs/criterion_binding"
        },
        "report_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\x00-\\x1f]*\\S[^\\x00-\\x1f]*$"
        },
        "receipt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "binding",
        "criteria_sha256",
        "reviewer_id",
        "state",
        "decision",
        "brief",
        "output"
      ],
      "properties": {
        "schema": {
          "const": "botte.mission-review/v1"
        },
        "binding": {
          "$ref": "#/$defs/binding"
        },
        "criteria_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "reviewer_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\x00-\\x1f]*\\S[^\\x00-\\x1f]*$"
        },
        "state": {
          "enum": [
            "requested",
            "running",
            "completed",
            "failed",
            "interrupted",
            "quota_exhausted",
            "quota_exceeded",
            "cancelled",
            "timed_out",
            "unknown"
          ]
        },
        "decision": {
          "enum": [
            "accepted",
            "changes_requested",
            "unknown"
          ]
        },
        "brief": {
          "oneOf": [
            {
              "$ref": "#/$defs/file"
            },
            {
              "type": "null"
            }
          ]
        },
        "output": {
          "oneOf": [
            {
              "$ref": "#/$defs/file"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "completed"
              }
            }
          },
          "then": {
            "properties": {
              "brief": {
                "$ref": "#/$defs/file"
              },
              "output": {
                "$ref": "#/$defs/file"
              }
            }
          }
        }
      ]
    }
  }
}
