{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zedarvates/botte-secrete/blob/main/docs/schemas/capability-effects.schema.json",
  "title": "Capability effects declaration v1",
  "$comment": "The inspector additionally checks the caller-resolved capability identity, relative local source paths, size limits, duplicate keys and matching SHA-256 digests. Schema validity does not validate effects or grant authority.",
  "type": "object",
  "required": [
    "schema",
    "capability_id",
    "contract_version",
    "source_hashes",
    "preconditions",
    "expected_effects",
    "downstream_effects",
    "reversibility",
    "retry",
    "required_scope",
    "analysis",
    "reuse"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "botte.capability-effects/v1"
    },
    "capability_id": {
      "type": "string",
      "pattern": "\\S"
    },
    "contract_version": {
      "type": "string",
      "pattern": "\\S"
    },
    "source_hashes": {
      "type": "object",
      "required": [
        "SKILL.md"
      ],
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\S"
      }
    },
    "expected_effects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "effect",
          "scope",
          "basis",
          "impact",
          "verification",
          "likelihood"
        ],
        "additionalProperties": false,
        "properties": {
          "effect": {
            "type": "string",
            "pattern": "\\S"
          },
          "scope": {
            "type": "string",
            "pattern": "\\S"
          },
          "basis": {
            "type": "string",
            "pattern": "\\S"
          },
          "impact": {
            "type": "string",
            "pattern": "\\S"
          },
          "verification": {
            "type": "string",
            "pattern": "\\S"
          },
          "likelihood": {
            "enum": [
              "conditional",
              "probable",
              "plausible",
              "unknown"
            ]
          }
        }
      }
    },
    "downstream_effects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "effect",
          "scope",
          "basis",
          "impact",
          "verification",
          "likelihood"
        ],
        "additionalProperties": false,
        "properties": {
          "effect": {
            "type": "string",
            "pattern": "\\S"
          },
          "scope": {
            "type": "string",
            "pattern": "\\S"
          },
          "basis": {
            "type": "string",
            "pattern": "\\S"
          },
          "impact": {
            "type": "string",
            "pattern": "\\S"
          },
          "verification": {
            "type": "string",
            "pattern": "\\S"
          },
          "likelihood": {
            "enum": [
              "conditional",
              "probable",
              "plausible",
              "unknown"
            ]
          }
        }
      }
    },
    "reversibility": {
      "type": "object",
      "required": [
        "status",
        "strategy",
        "residual_effects"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "read_only",
            "reversible",
            "partial",
            "irreversible",
            "unknown"
          ]
        },
        "strategy": {
          "type": "string",
          "pattern": "\\S"
        },
        "residual_effects": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    },
    "retry": {
      "type": "object",
      "required": [
        "semantics",
        "check_before_retry",
        "stop_condition"
      ],
      "additionalProperties": false,
      "properties": {
        "semantics": {
          "enum": [
            "idempotent",
            "conditional",
            "non_idempotent",
            "unknown"
          ]
        },
        "check_before_retry": {
          "type": "string",
          "pattern": "\\S"
        },
        "stop_condition": {
          "type": "string",
          "pattern": "\\S"
        }
      }
    },
    "required_scope": {
      "type": "string",
      "pattern": "\\S"
    },
    "analysis": {
      "type": "object",
      "required": [
        "summary",
        "uncertainties",
        "evidence_refs"
      ],
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "string",
          "pattern": "\\S"
        },
        "uncertainties": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    },
    "reuse": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "target",
          "rationale",
          "adaptations",
          "validation",
          "status",
          "validated_context",
          "evidence_refs"
        ],
        "additionalProperties": false,
        "properties": {
          "target": {
            "type": "string",
            "pattern": "\\S"
          },
          "rationale": {
            "type": "string",
            "pattern": "\\S"
          },
          "adaptations": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "\\S"
            }
          },
          "validation": {
            "type": "string",
            "pattern": "\\S"
          },
          "status": {
            "enum": [
              "validated_in_context",
              "adaptation_to_test",
              "exploratory"
            ]
          },
          "validated_context": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "\\S"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "validated_in_context"
                }
              }
            },
            "then": {
              "properties": {
                "validated_context": {
                  "type": "string",
                  "pattern": "\\S"
                },
                "evidence_refs": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "pattern": "\\S"
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}
