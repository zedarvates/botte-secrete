{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zedarvates/botte-secrete/blob/main/docs/schemas/migration-audit-spec.schema.json",
  "title": "Botte deterministic migration audit specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "migration_id", "checks"],
  "properties": {
    "schema": {"const": "botte.migration-audit-spec/v1"},
    "migration_id": {
      "type": "string", "minLength": 1, "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#-]{0,127}$"
    },
    "max_files": {"type": "integer", "minimum": 1, "maximum": 10000},
    "max_file_bytes": {"type": "integer", "minimum": 128, "maximum": 2097152},
    "checks": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "oneOf": [
          {
            "type": "object", "additionalProperties": false,
            "required": ["id", "kind", "pattern"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
              "kind": {"enum": ["text_absent", "text_present"]},
              "pattern": {"type": "string", "minLength": 1, "maxLength": 256},
              "include": {
                "type": "array", "minItems": 1, "maxItems": 20,
                "items": {"type": "string", "minLength": 1, "maxLength": 256}
              }
            }
          },
          {
            "type": "object", "additionalProperties": false,
            "required": ["id", "kind", "path"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
              "kind": {"enum": ["path_absent", "path_present"]},
              "path": {"type": "string", "minLength": 1, "maxLength": 256}
            }
          },
          {
            "type": "object", "additionalProperties": false,
            "required": ["id", "kind", "paths"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
              "kind": {"const": "paths_not_both"},
              "paths": {
                "type": "array", "minItems": 2, "maxItems": 2,
                "items": {"type": "string", "minLength": 1, "maxLength": 256}
              }
            }
          }
        ]
      }
    }
  }
}
