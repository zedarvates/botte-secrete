{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zedarvates/botte-secrete/blob/main/docs/schemas/asset-quality-report.schema.json",
  "title": "Asset Quality Memory input report",
  "type": "object",
  "additionalProperties": false,
  "required": ["family", "sha256", "size_bytes", "checks", "features"],
  "properties": {
    "family": {"enum": ["image", "texture", "mesh", "animation", "godot"]},
    "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "size_bytes": {"type": "integer", "minimum": 1},
    "checks": {
      "type": "object",
      "additionalProperties": {"type": "boolean"},
      "required": ["decodable", "license_verified", "manifest_verified"],
      "properties": {
        "decodable": {"type": "boolean"},
        "license_verified": {"type": "boolean"},
        "manifest_verified": {"type": "boolean"},
        "dimensions_valid": {"type": "boolean"},
        "finite_geometry": {"type": "boolean"},
        "nonempty_geometry": {"type": "boolean"},
        "valid_timeline": {"type": "boolean"},
        "importable": {"type": "boolean"}
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1},
      "minProperties": 4,
      "maxProperties": 6
    }
  }
}
