# Botte Secrète .gitignore

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/

# Rust build artifacts (machine-specific; the binary is rebuilt from src/)
target/
*.rlib
*.rmeta

# Node
node_modules/
*.min.js
*.min.css

# IDE
.idea/
.vscode/
*.swp
*.swo

# Agent workspace state (never part of a release)
.claude/
.codex/

# OS
.DS_Store
Thumbs.db

# Hailo models (large binaries)
*.hef
*.hn

# ComfyUI models (large binaries)
*.safetensors
*.ckpt
*.bin

# Bonsai models
*.gguf
*.onnx

# Reports (generated)
reports/
/tmp/

# Secrets
*.env.local
*.secret
configs/botte-secrete.env

# Local agent knowledge (may contain private project or machine context)
/MEMORY.md

# Large data files
*.sqlite
*.db
.botte-cache/

# Machine-specific generated LLM registry (regenerate with: llm_backends scan)
configs/llm-endpoints.json

# Local MCP wiring (per-machine absolute paths)
.mcp.json

# Per-project deployer output (machine-specific paths + config). Traverse the
# directory only to retain the two explicit governance contracts below.
.botte/*
!.botte/policy.md
!.botte/rules.json

# Generated artifacts
fix-report.json
*.vtt
.venv312/
transcript.fr.srt
