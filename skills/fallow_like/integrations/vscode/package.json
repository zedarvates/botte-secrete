{
  "name": "fallow-like",
  "displayName": "Fallow-Like — Codebase Intelligence",
  "description": "Multi-language codebase analysis: dead code, duplication, complexity, secrets, architecture boundaries",
  "version": "0.1.0",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Linters", "Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      { "command": "fallowLike.analyze", "title": "Fallow-Like: Analyze Project" },
      { "command": "fallowLike.health", "title": "Fallow-Like: Show Health Score" },
      { "command": "fallowLike.deadCode", "title": "Fallow-Like: Find Dead Code" },
      { "command": "fallowLike.secrets", "title": "Fallow-Like: Scan for Secrets" }
    ],
    "configuration": {
      "title": "Fallow-Like",
      "properties": {
        "fallowLike.pythonPath": {
          "type": "string", "default": "python3",
          "description": "Path to Python interpreter"
        },
        "fallowLike.autoAnalyze": {
          "type": "boolean", "default": false,
          "description": "Auto-analyze on save"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  }
}
