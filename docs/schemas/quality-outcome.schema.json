{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zedarvates/botte-secrete/blob/main/docs/schemas/quality-outcome.schema.json",
  "title": "Botte Secrete bounded execution outcome",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "id", "recorded_at", "timestamp", "execution_fingerprint",
    "source", "task_fingerprint", "task_type", "tags", "route", "status",
    "verdict", "verification_state", "verified", "verified_by",
    "evidence_refs", "risk", "permission_profile", "model", "harness",
    "tool_versions", "duration_ms", "cost_usd", "tokens", "memory_mb",
    "energy_wh", "acted", "abstained", "escalated", "approval_required",
    "shadow_only", "activation_allowed", "raw_task_stored", "trajectory_id"
  ],
  "properties": {
    "schema": {"const": "botte.quality-outcome/v1"},
    "id": {"type": "string", "pattern": "^qo_[0-9a-f]{16}$"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "timestamp": {"type": "number"},
    "execution_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source": {"type": "string", "maxLength": 64},
    "task_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "task_type": {"type": "string", "maxLength": 64},
    "tags": {"type": "array", "maxItems": 50, "items": {"type": "string", "maxLength": 64}},
    "route": {"enum": ["deterministic", "local", "cloud", "human"]},
    "status": {"enum": ["PARTIAL", "FAIL", "UNCERTAIN", "PASS", "PASS_ROBUST", "ABSTAINED", "ESCALATED", "APPROVAL_REQUIRED"]},
    "verdict": {"type": ["string", "null"], "enum": ["FAIL", "UNCERTAIN", "PASS", "PASS_ROBUST", null]},
    "verification_state": {"enum": ["unverified", "rejected", "verified"]},
    "verified": {"type": "boolean"},
    "verified_by": {"type": "string", "maxLength": 128},
    "evidence_refs": {"type": "array", "maxItems": 20, "items": {"type": "string", "maxLength": 256}},
    "risk": {"enum": ["low", "standard", "high", "critical"]},
    "permission_profile": {"type": "string", "maxLength": 64},
    "model": {"type": "string", "maxLength": 128},
    "harness": {"type": "string", "maxLength": 128},
    "tool_versions": {"type": "object", "maxProperties": 20, "propertyNames": {"maxLength": 64}, "additionalProperties": {"type": "string", "maxLength": 128}},
    "duration_ms": {"type": ["number", "null"], "minimum": 0},
    "cost_usd": {"type": ["number", "null"], "minimum": 0},
    "tokens": {"type": ["integer", "null"], "minimum": 0},
    "memory_mb": {"type": ["number", "null"], "minimum": 0},
    "energy_wh": {"type": ["number", "null"], "minimum": 0},
    "acted": {"type": "boolean"},
    "abstained": {"type": "boolean"},
    "escalated": {"type": "boolean"},
    "approval_required": {"type": "boolean"},
    "shadow_only": {"const": true},
    "activation_allowed": {"const": false},
    "raw_task_stored": {"const": false},
    "trajectory_id": {"type": ["string", "null"], "pattern": "^qa_[0-9a-f]{12}$"}
  }
}
