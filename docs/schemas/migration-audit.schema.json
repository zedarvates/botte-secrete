{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zedarvates/botte-secrete/blob/main/docs/schemas/migration-audit.schema.json",
  "title": "Botte deterministic migration audit result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "migration_id", "status", "reason_code", "checks", "summary",
    "evidence_count", "authority", "shadow_only", "activation_allowed",
    "executed_project_code", "privacy"
  ],
  "properties": {
    "schema": {"const": "botte.migration-audit/v1"},
    "migration_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "status": {"enum": ["PASS", "FAIL", "UNCERTAIN"]},
    "reason_code": {"enum": ["migration_complete", "migration_incomplete", "evidence_incomplete"]},
    "checks": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "kind", "status", "reason_code", "matched_files", "candidate_files", "paths"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
          "kind": {"enum": ["text_absent", "text_present", "path_absent", "path_present", "paths_not_both"]},
          "status": {"enum": ["PASS", "FAIL", "UNCERTAIN"]},
          "reason_code": {"type": "string", "minLength": 1, "maxLength": 64},
          "matched_files": {"type": "integer", "minimum": 0},
          "candidate_files": {"type": "integer", "minimum": 0},
          "paths": {"type": "array", "maxItems": 20, "items": {"type": "string", "maxLength": 256}}
        }
      }
    },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["total", "passed", "failed", "uncertain", "scanned_files", "truncated"],
      "properties": {
        "total": {"type": "integer", "minimum": 1, "maximum": 100},
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "uncertain": {"type": "integer", "minimum": 0},
        "scanned_files": {"type": "integer", "minimum": 0, "maximum": 10000},
        "truncated": {"type": "boolean"}
      }
    },
    "evidence_count": {"type": "integer", "minimum": 0},
    "authority": {"const": "SIMULATE"},
    "shadow_only": {"const": true},
    "activation_allowed": {"const": false},
    "executed_project_code": {"const": false},
    "privacy": {
      "type": "object", "additionalProperties": false,
      "required": ["raw_source", "matched_text", "absolute_paths"],
      "properties": {
        "raw_source": {"const": false},
        "matched_text": {"const": false},
        "absolute_paths": {"const": false}
      }
    }
  }
}
