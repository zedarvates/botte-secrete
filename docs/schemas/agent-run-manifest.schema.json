{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zedarvates/botte-secrete/blob/main/docs/schemas/agent-run-manifest.schema.json",
  "title": "Botte Secrete bounded Codex or Hermes run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "agent", "execution_id", "task", "route", "status"],
  "properties": {
    "schema": {"const": "botte.agent-run/v1"},
    "agent": {"enum": ["codex", "hermes"]},
    "execution_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "task": {"type": "string", "minLength": 1, "maxLength": 20000},
    "task_type": {"type": "string", "maxLength": 64},
    "tags": {"type": "array", "maxItems": 50, "items": {"type": "string", "maxLength": 64}},
    "route": {"enum": ["deterministic", "local", "cloud", "human"]},
    "status": {"enum": ["PARTIAL", "FAIL", "UNCERTAIN", "PASS", "PASS_ROBUST", "ABSTAINED", "ESCALATED", "APPROVAL_REQUIRED"]},
    "verdict": {"enum": ["FAIL", "UNCERTAIN", "PASS", "PASS_ROBUST", null]},
    "verified_by": {"type": "string", "maxLength": 128},
    "evidence_refs": {"type": "array", "maxItems": 20, "items": {"type": "string", "maxLength": 256}},
    "quality_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "risk": {"enum": ["low", "standard", "high", "critical"]},
    "permission_profile": {"type": "string", "maxLength": 64},
    "model": {"type": "string", "maxLength": 128},
    "harness": {"type": "string", "maxLength": 128},
    "tool_versions": {"type": "object", "maxProperties": 20, "additionalProperties": {"type": "string", "maxLength": 128}},
    "duration_ms": {"type": ["number", "null"], "minimum": 0},
    "cost_usd": {"type": ["number", "null"], "minimum": 0},
    "tokens": {"type": ["integer", "null"], "minimum": 0},
    "memory_mb": {"type": ["number", "null"], "minimum": 0},
    "energy_wh": {"type": ["number", "null"], "minimum": 0},
    "acted": {"type": "boolean"},
    "abstained": {"type": "boolean"},
    "escalated": {"type": "boolean"},
    "approval_required": {"type": "boolean"}
  }
}
